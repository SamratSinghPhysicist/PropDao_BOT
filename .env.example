# PropDAO API Configuration
# Get your live key at https://app.propdao.finance (Avatar -> Settings -> Developers -> Generate Key)
PROPDAO_API_KEY=pd_live_your_api_key_here

# Target Account ID
# Choose which account you want to trade:
# For 50k Trial Account (DEMO / Paper) --> PROP-HG2JY49A
# (If left blank, the bot will interactively ask you to choose from your available accounts)
PROPDAO_ACCOUNT=PROP-HG2JY49A

# Execution Mode:
# 'paper' = Free Trial / Demo account trading on PropDAO platform
# 'live'  = Paid Evaluation / Funded account trading on PropDAO platform
PROPDAO_MODE=paper

# Default Trading Settings (Multi-Asset High-Frequency Watchlist on 1m Timeframe)
PROPDAO_SYMBOLS=NEARUSDC,SUIUSDC,GOLDUSDC,SILVERUSDC,BTCUSDC,ETHUSDC,SOLUSDC,TSLAUSDC,SPCXUSDC,GOOGLUSDC,XRPUSDC,TRUMPUSDC
PROPDAO_SYMBOL=NEARUSDC,SUIUSDC,GOLDUSDC,SILVERUSDC,BTCUSDC,ETHUSDC,SOLUSDC,TSLAUSDC,SPCXUSDC,GOOGLUSDC,XRPUSDC,TRUMPUSDC
PROPDAO_TIMEFRAME=1m
PROPDAO_MAX_POSITIONS=3
PROPDAO_LEVERAGE=1.0
PROPDAO_RISK_FRACTION=0.25
