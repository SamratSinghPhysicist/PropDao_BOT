# PropDAO API Configuration
# Get your live key at https://app.propdao.finance (Avatar -> Settings -> Developers -> Generate Key)
PROPDAO_API_KEY=pd_live_your_api_key_here

# Target Account ID
# Choose which account you want to trade:
# For 50k Trial Account (DEMO / Paper) --> PROP-L6AS4Z5H
# For 25k Eval Account (LIVE - REAL)   --> PROP-C137DA4E
# (If left blank, the bot will interactively ask you to choose from your available accounts)
PROPDAO_ACCOUNT=PROP-L6AS4Z5H

# Execution Mode:
# 'paper' = Free Trial / Demo account trading on PropDAO platform
# 'live'  = Paid Evaluation / Funded account trading on PropDAO platform
PROPDAO_MODE=paper

# Default Trading Settings (Optimized for BTC Live Deployment)
PROPDAO_SYMBOL=BTCUSDC
PROPDAO_TIMEFRAME=4h
PROPDAO_LEVERAGE=1.0
PROPDAO_RISK_FRACTION=0.25
